{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kamin-korostyshiv",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kamin-korostyshiv-production",
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "../database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_MEDIA_PRIVATE",
      "bucket_name": "kaminchyk-product-originals"
    },
    {
      "binding": "PRODUCT_MEDIA_PUBLIC",
      "bucket_name": "kaminchyk-product-public"
    },
    {
      "binding": "LEAD_ATTACHMENTS",
      "bucket_name": "kaminchyk-lead-attachments"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "YOUR_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "PASTE_ACCESS_APPLICATION_AUD_HERE",
    "ADMIN_EMAILS": "owner@example.com",
    "MEDIA_PUBLIC_BASE_URL": "https://media.example.com",
    "TELEGRAM_SEND_ATTACHMENTS": "false"
  }
}
