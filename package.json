{
  "name": "kamin-korostyshiv",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev",
    "build": "next build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:unit && npm run worker:check",
    "test:unit": "node --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern out --ignore-pattern dist --ignore-pattern .next --ignore-pattern .sites-runtime",
    "typecheck": "tsc --noEmit",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .worker-dist",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Камінь Коростишів — граніт та мармур"
}
